{
  "name": "mynil-music",
  "version": "1.0.5",
  "description": "Mynil Music — Instant YouTube-powered Music & Music Video Streaming App",
  "main": "backend/server.js",
  "author": "Toby",
  "private": true,
  "sona": {
    "githubRepo": "TobSha-alt/Mynil-Music"
  },
  "scripts": {
    "dev:server": "node backend/server.js",
    "dev:vite": "vite",
    "dev": "concurrently -k --success first \"npm:dev:server\" \"npm:dev:vite\"",
    "build": "vite build",
    "build:win": "dotnet publish native/windows/Sona.csproj -c Release -r win-x64 --no-self-contained -o Mynil-win",
    "start": "npm run build && node -e \"const {spawn}=require('child_process');const cmd=process.platform==='win32'?'Mynil-win\\\\Mynil.exe':'open';const args=process.platform==='win32'?[]:['./Mynil.app'];spawn(cmd,args,{detached:true,stdio:'ignore'}).unref();\""
  },
  "dependencies": {
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
